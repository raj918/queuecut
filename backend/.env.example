# ==========================================
# QUEUECUT BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=QueueCut
API_PREFIX=/api

# Database (Supabase PostgreSQL / Standard PostgreSQL)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars-long"
JWT_REFRESH_EXPIRES_IN="30d"

# Supabase Realtime & Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Firebase Cloud Messaging (Admin SDK)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="queuecut-production"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@queuecut-production.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Platform Business Rules
DEFAULT_COMMISSION_RATE=5.0
DEFAULT_SEARCH_RADIUS_METERS=500
MAX_SEARCH_RADIUS_METERS=5000
