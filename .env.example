# ==========================================
# QUEUECUT ROOT MONOREPO ENVIRONMENT TEMPLATE
# ==========================================

# Backend Settings
PORT=5000
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars-long"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
FIREBASE_PROJECT_ID="queuecut-production"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@queuecut-production.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mobile App Settings (Copy to apps/mobile/.env)
API_BASE_URL="http://10.0.2.2:5000/api" # Use 10.0.2.2 for Android Emulator, or your local LAN IP for physical phone, or Vercel URL
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
MAPLIBRE_STYLE_URL="https://tiles.openfreemap.org/styles/bright" # Free, open, high-performance OSM style
DEFAULT_LATITUDE=26.4499
DEFAULT_LONGITUDE=80.3319 # Kanpur, UP coordinates
